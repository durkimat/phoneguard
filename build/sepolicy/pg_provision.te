# Domain for pg-provision.sh (first-boot device-owner provisioning, build/apps/module/pg-provision.sh).
type pg_provision, domain, coredomain;
type pg_provision_exec, exec_type, file_type, system_file_type;
init_daemon_domain(pg_provision)

binder_use(pg_provision)
binder_call(pg_provision, system_server)
allow pg_provision servicemanager:service_manager list;
allow pg_provision { device_policy_service package_service activity_service settings_service radio_service }:service_manager find;
allow pg_provision shell_exec:file rx_file_perms;
allow pg_provision toolbox_exec:file rx_file_perms;
allow pg_provision system_file:file rx_file_perms;
allow pg_provision system_file:dir r_dir_perms;

# `cmd` hands system_server its stdin/stdout/stderr in the binder call; without this every cmd call fails with "Failed transaction (2147483646)".
allow system_server pg_provision:fd use;
allow system_server pg_provision:fifo_file { read write getattr };

# system_server calls back into the `cmd` client (shell callback / result receiver) during the transaction.
allow system_server pg_provision:binder { call transfer };
allow system_server pg_provision:unix_stream_socket { read write getattr };
allow system_server pg_provision:file { read getattr open };
