+    private void handlePgF2WhenScreenOff(KeyEvent event, boolean down) {
+        final long now = SystemClock.uptimeMillis();
+        if (down) {
+            if (mPgF2DownAt == 0) mPgF2DownAt = now; // ignore key repeats
+            return;
+        }
+        final long heldFor = mPgF2DownAt == 0 ? 0 : now - mPgF2DownAt;
+        mPgF2DownAt = 0;
+        if (heldFor >= PG_F2_HOLD_MS) {
+            mPgF2LastTapAt = 0;
+            return;
+        }
+        if (mPgF2LastTapAt != 0 && now - mPgF2LastTapAt <= PG_F2_DOUBLE_MS) {
+            mPgF2LastTapAt = 0;
+            mHandler.removeMessages(MSG_PG_TOGGLE_TORCH);
+            // asynchronously, like the power key torch, to keep the input thread quick
+            mHandler.sendMessage(mHandler.obtainMessage(MSG_PG_TOGGLE_TORCH));
+        } else {
+            mPgF2LastTapAt = now;
         }
