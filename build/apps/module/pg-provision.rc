# Phone Guard first-boot provisioning (pg-provision.sh): plumbing always; device owner only on request from the app (family edition).
service pg_provision /system_ext/bin/pg-provision.sh
    class late_start
    user root
    group root
    seclabel u:r:pg_provision:s0
    disabled
    oneshot

on property:sys.boot_completed=1
    start pg_provision
