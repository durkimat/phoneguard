// Third-party apps that go into the image as they are (docs/apps-in-image.md lists source, version and checksum).
// Not re-signed: the author's signature stays so updates from the same source keep working.

android_app_import { name: "TT9", apk: "tt9.apk", presigned: true, preprocessed: true, dex_preopt: { enabled: false }, }

// Phone Guard itself (controller/), a privileged system app signed with ITS OWN release key (not the platform key): see docs/integration-plan.md.
// It stays updatable by the same-key release flow; the allowlist below is what grants its privileged permissions.
android_app_import { name: "PhoneGuard", apk: "phoneguard.apk", presigned: true, preprocessed: true, privileged: true, overrides: [
        // Stock launcher: Phone Guard Home replaces it.
        "TrebuchetQuickStep", "Launcher3QuickStep", "Launcher3", "Launcher3Go",
        // Lineage apps Phone Guard has its own versions of, or that a keypad phone does not use (docs/image-trim.md). Add back by deleting the name here.
        "Eleven", "Gallery2", "Aperture", "ApertureLensLauncher", "Glimpse", "Jelly", "Etar", "Recorder", "PhotoTable", "Backgrounds",
        "ThemePicker", "LineageSetupWizard", "Seedvault", "ExactCalculator", "AudioFX",
    ], dex_preopt: { enabled: false }, }

// FM radio from the stock Qin firmware (docs/fm-radio.md): the MediaTek FM app (com.android.fmradio 2.0, Duoqin-signed, left as is) and its JNI library.
android_app_import { name: "FMRadio", apk: "fm/FMRadio.apk", presigned: true, preprocessed: true, privileged: true, system_ext_specific: true, dex_preopt: { enabled: false }, }
