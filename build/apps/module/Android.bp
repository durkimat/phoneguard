// Third-party apps that go into the image as they are (docs/apps-in-image.md lists source, version and checksum).
// Not re-signed: the author's signature stays so updates from the same source keep working.

android_app_import { name: "TT9", apk: "tt9.apk", presigned: true, preprocessed: true, dex_preopt: { enabled: false }, }

// Phone Guard itself (controller/), a privileged system app signed with ITS OWN release key (not the platform key): see docs/integration-plan.md.
// It stays updatable by the same-key release flow; the allowlist below is what grants its privileged permissions.
android_app_import { name: "PhoneGuard", apk: "phoneguard.apk", presigned: true, preprocessed: true, privileged: true, overrides: ["TrebuchetQuickStep", "Launcher3QuickStep", "Launcher3", "Launcher3Go"], dex_preopt: { enabled: false }, }
