#!/bin/bash
echo "adb $*" >> "$FAKE_LOG"
case "$1" in
  version) echo "Android Debug Bridge version 1.0.41" ;;
  devices) [ -n "$FAKE_DAEMON_NOISE" ] && printf '* daemon not running; starting now at tcp:5037\n* daemon started successfully\n'; printf 'List of devices attached\n%s\t%s\n' "${FAKE_SERIAL:-ABC123}" "${FAKE_ADB_STATE:-device}" ;;
  reboot) : ;;
  pull) mkdir -p "$(dirname "$3")"; [ -n "$FAKE_NO_PULL" ] && { echo "adb: error: remote object does not exist" >&2; exit 1; }; echo fake > "$3" ;;
  shell) shift; case "$*" in
    "getprop ro.product.vendor.model") echo "${FAKE_MODEL:-Qin J36}" ;;
    "getprop ro.product.model") echo "TrebleDroid vanilla" ;;
    "dumpsys battery") echo "Current Battery Service state:"; echo "  level: ${FAKE_BATT:-80}" ;;
    "getprop") echo "[ro.build.id]: [X]" ;;
    "pm list packages -f") echo "package:/system/app/Clock.apk=com.android.deskclock" ;;
  esac ;;
esac
